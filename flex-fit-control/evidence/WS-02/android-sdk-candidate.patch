+            capturedStateListener = it.getArgument(0)
+            checkNotNull(capturedStateListener).onStateChanged(state)
+        }
+        whenever(mockFlagsClient.setEvaluationContext(any(), any())).doAnswer { invocation ->
+            fetches++
+            val callback = invocation.getArgument<EvaluationContextCallback>(1)
+            state = FlagsClientState.Reconciling
+            capturedStateListener?.onStateChanged(state)
+            if (fetches == 1) {
+                state = FlagsClientState.Ready
+                capturedStateListener?.onStateChanged(state)
+                callback.onSuccess()
+            } else {
+                pendingCallback = callback
+            }
+        }
+
+        // When
+        OpenFeatureAPI.setProviderAndWait(provider, context, dispatcher = UnconfinedTestDispatcher(testScheduler))
+        assertThat(OpenFeatureAPI.getStatus()).isEqualTo(OpenFeatureStatus.Ready)
+        val secondProvider = DatadogFlagsProvider.wrap(mockFlagsClient, mockSdkCore)
+        val registering = async {
