+import java.math.BigDecimal
+
+internal class FlagValueConverterTest {
+    @Test
+    fun `M retain native integer boundaries W convert() {numeric variation types}`() {
+        // When / Then
+        listOf("integer", "float", "number").forEach { type ->
+            listOf(Int.MIN_VALUE, 0, Int.MAX_VALUE).forEach { value ->
+                assertThat(FlagValueConverter.convert(value.toString(), type, Int::class).getOrThrow())
+                    .isEqualTo(value)
+            }
+            assertThat(FlagValueConverter.convert("2.0", type, Int::class).getOrThrow()).isEqualTo(2)
+        }
+    }
+
+    @Test
+    fun `M reject integer overflow and fractions W convert()`() {
+        // When / Then
+        listOf("-2147483649", "2147483648", "2.5", "NaN", "Infinity").forEach { value ->
+            listOf("integer", "float", "number").forEach { type ->
+                assertThat(FlagValueConverter.convert(value, type, Int::class).exceptionOrNull())
+                    .isInstanceOf(TypeMismatchException::class.java)
+            }
+        }
+    }
+
+    @Test
+    fun `M preserve exactly representable double values W convert()`() {
+        // When / Then
+        listOf(
+            "-2147483649",
+            "2147483648",
+            "9007199254740992",
+            "-9223372036854775808",
+            "2.5",
+            "9007199254740993.5",
+            "0.0",
+            "-0.0",
+            "4.9e-324",
+            BigDecimal(Double.MAX_VALUE).toPlainString()
+        ).forEach { value ->
+            listOf("integer", "float", "number").forEach { type ->
+                assertThat(FlagValueConverter.convert(value, type, Double::class).getOrThrow())
+                    .isEqualTo(value.toDouble())
+            }
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(
+        strings = [
+            "9007199254740993", "-9007199254740993", "9223372036854775807", "NaN", "Infinity",
+            "1e309", "1e-400", "-1e-400", "9007199254740993.0", "9007199254740993e0",
+            "1.7976931348623157e308"
+        ]
+    )
+    fun `M reject rounded or nonfinite double values W convert()`(value: String) {
+        // When / Then
+        listOf("integer", "float", "number").forEach { type ->
+            assertThat(FlagValueConverter.convert(value, type, Double::class).exceptionOrNull())
+                .isInstanceOf(TypeMismatchException::class.java)
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = ["integer", "float", "number"])
+    fun `M preserve original numeric tokens W convert() {parsed canonical decimal responses}`(declaration: String) {
+        // Given
+        val testedMapper = PrecomputeMapper(mock<InternalLogger>())
+        val resource = checkNotNull(javaClass.getResource("/numeric-decimal-$declaration.json"))
+        val fixture = JsonParser.parseString(resource.readText()).asJsonObject
+        val assignments = checkNotNull(testedMapper.map(fixture.get("response").toString()))
+
+        // When / Then
+        fixture.getAsJsonArray("evaluations").forEach { element ->
+            val evaluation = element.asJsonObject
+            val flag = checkNotNull(assignments.flags[evaluation.get("flag").asString])
+            val expected = evaluation.getAsJsonObject("expectedResult")
+            val integerRead = evaluation.get("variationType").asString == "integer"
+            val result = if (integerRead) {
+                FlagValueConverter.convert(flag.variationValue, flag.variationType, Int::class)
+            } else {
+                FlagValueConverter.convert(flag.variationValue, flag.variationType, Double::class)
+            }
+            if (!expected.get("errorCode").isJsonNull) {
+                assertThat(result.exceptionOrNull()).isInstanceOf(TypeMismatchException::class.java)
+            } else {
+                assertThat((result.getOrThrow() as Number).toDouble())
+                    .isEqualTo(expected.get("value").asDouble)
+            }
+        }
+    }
+}
