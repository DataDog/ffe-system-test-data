+package com.datadog.android.flags.openfeature
+
+import dev.openfeature.kotlin.sdk.EvaluationContext
+import dev.openfeature.kotlin.sdk.ImmutableContext
+import dev.openfeature.kotlin.sdk.Value
+
+/**
+ * An OpenFeature context that distinguishes an absent targeting key from an explicitly blank key.
+ *
+ * Pass this context through the OpenFeature API when using [DatadogFlagsProvider]. The provider
+ * preserves [targetingKeyOrNull] on requests. Other providers using [getTargetingKey] see an empty
+ * string when the key is absent because OpenFeature's Kotlin API requires a non-null string.
+ *
+ * @param targetingKeyOrNull The targeting key, or null to omit it. An empty string stays blank.
+ * @param attributes JSON-valued evaluation attributes.
+ */
+class DatadogEvaluationContext(
+    val targetingKeyOrNull: String? = null,
+    attributes: Map<String, Value> = emptyMap()
+) : EvaluationContext by ImmutableContext(targetingKeyOrNull ?: "", attributes) {
+    private val context = ImmutableContext(targetingKeyOrNull ?: "", attributes)
+
+    override fun withTargetingKey(targetingKey: String): DatadogEvaluationContext =
+        DatadogEvaluationContext(targetingKey, context.asMap())
+
+    override fun equals(other: Any?): Boolean = other is DatadogEvaluationContext &&
+        targetingKeyOrNull == other.targetingKeyOrNull && context.asMap() == other.asMap()
+
+    override fun hashCode(): Int = 31 * (targetingKeyOrNull?.hashCode() ?: 0) + context.hashCode()
+}
