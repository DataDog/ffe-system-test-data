+                secondProvider,
+                context,
+                dispatcher = UnconfinedTestDispatcher(testScheduler)
+            )
+        }
+        testScheduler.runCurrent()
+        assertThat(registering.isCompleted).isFalse()
+        state = FlagsClientState.Stale
+        capturedStateListener?.onStateChanged(state)
+        testScheduler.runCurrent()
+        assertThat(registering.isCompleted).isFalse()
+        checkNotNull(pendingCallback).onFailure(failure)
+        registering.await()
+        testScheduler.runCurrent()
+
+        // Then
+        assertThat(fetches).isEqualTo(2)
+        assertThat(state).isEqualTo(FlagsClientState.Stale)
