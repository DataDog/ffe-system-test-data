+package com.datadog.rumtestapp.ipc
+
+import com.google.protobuf.ListValue
+import com.google.protobuf.NullValue
+import com.google.protobuf.Struct
+import com.google.protobuf.Value
+import dev.openfeature.kotlin.sdk.Builder
+import io.grpc.Status
+import io.grpc.StatusException
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+internal class FeatureFlagConversionsTest {
+    @Test
+    fun `integer RPC defaults retain native Int32 limits without truncation`() {
+        listOf(Int.MIN_VALUE.toLong(), 0L, Int.MAX_VALUE.toLong())
+            .forEach { value -> assertEquals(value.toInt(), checkedIntegerDefault(value)) }
+        listOf(Long.MIN_VALUE, Long.MAX_VALUE, Int.MIN_VALUE.toLong() - 1, Int.MAX_VALUE.toLong() + 1)
+            .forEach { value ->
+                val failure = assertThrows(StatusException::class.java) { checkedIntegerDefault(value) }
+                assertEquals(Status.Code.INVALID_ARGUMENT, failure.status.code)
+            }
+    }
+
+    @Test
+    fun `nested object defaults survive the OpenFeature conversion`() {
+        val original = Struct.newBuilder()
+            .putFields("false", Value.newBuilder().setBoolValue(false).build())
+            .putFields("zero", Value.newBuilder().setNumberValue(0.0).build())
+            .putFields("blank", Value.newBuilder().setStringValue("").build())
+            .putFields("null", Value.newBuilder().setNullValue(NullValue.NULL_VALUE).build())
+            .putFields(
+                "nested",
+                Value.newBuilder().setListValue(
+                    ListValue.newBuilder().addValues(
+                        Value.newBuilder().setStructValue(
+                            Struct.newBuilder().putFields(
+                                "fraction",
+                                Value.newBuilder().setNumberValue(2.5).build()
+                            )
+                        )
+                    )
+                ).build()
+            )
+            .build()
+
+        assertEquals(original, ofValueToStruct(structToOfValue(original)))
+    }
+
+    @Test
+    fun `blank and absent targeting keys remain distinct`() {
+        val blank = EvaluationContext.newBuilder().setTargetingKey("").build()
+        assertEquals("", toOfContext(blank).getTargetingKey())
+        assertEquals("", toOfContext(blank).targetingKeyOrNull)
+        assertEquals(null, toOfContext(EvaluationContext.getDefaultInstance()).targetingKeyOrNull)
+    }
+
+    @Test
+    fun `explicit targeting key overrides the same named context attribute`() {
+        val context = EvaluationContext.newBuilder()
+            .setTargetingKey("explicit")
+            .putAttributes("targetingKey", Value.newBuilder().setStringValue("attribute").build())
+            .build()
+        assertEquals("explicit", toOfContext(context).getTargetingKey())
+        assertFalse(toOfContext(context).asMap().containsKey("targetingKey"))
+        assertEquals("attribute", toOfContext(context.toBuilder().clearTargetingKey().build()).getTargetingKey())
+    }
+
+    @Test
+    fun `metadata preserves false and zero without inventing absent fields`() {
+        val metadata = Builder()
+            .putString("allocationKey", "allocation")
+            .putInt("__dd_split_serial_id", 0)
+            .putBoolean("doLog", false)
+            .build()
+        val actual = exposedMetadata(metadata)
+        assertEquals("allocation", actual.fieldsMap.getValue("allocationKey").stringValue)
+        assertEquals(0.0, actual.fieldsMap.getValue("__dd_split_serial_id").numberValue, 0.0)
+        assertFalse(actual.fieldsMap.getValue("doLog").boolValue)
+        assertEquals(0, exposedMetadata(Builder().build()).fieldsCount)
+    }
+
+    @Test
+    fun `evaluation and context update fail before initialization`() = runBlocking {
+        val service = FeatureFlagServiceImpl(null)
+        try {
+            service.evaluateBoolean(EvaluateBooleanRequest.getDefaultInstance())
+            throw AssertionError("Expected a precondition error")
+        } catch (failure: StatusException) {
+            assertEquals(Status.Code.FAILED_PRECONDITION, failure.status.code)
+        }
+        try {
+            service.setEvaluationContext(SetEvaluationContextRequest.getDefaultInstance())
+            throw AssertionError("Expected a precondition error")
+        } catch (failure: StatusException) {
+            assertEquals(Status.Code.FAILED_PRECONDITION, failure.status.code)
+        }
+    }
+
+    @Test
+    fun `wire presence is rejected before SDK initialization`() = runBlocking {
+        val service = FeatureFlagServiceImpl(null)
+        try {
+            service.initProvider(InitProviderRequest.newBuilder().setConfigurationWire("").build())
+            throw AssertionError("Expected an unsupported-mode error")
+        } catch (failure: StatusException) {
+            assertEquals(Status.Code.UNIMPLEMENTED, failure.status.code)
+        }
+    }
+}
