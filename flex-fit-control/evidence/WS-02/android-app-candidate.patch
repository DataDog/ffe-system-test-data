+package com.datadog.rumtestapp.ipc
+
+import com.datadog.android.flags.Flags
+import com.datadog.android.flags.FlagsClient
+import com.datadog.android.flags.FlagsConfiguration
+import com.datadog.android.flags.openfeature.DatadogEvaluationContext
+import com.datadog.android.flags.openfeature.asOpenFeatureProvider
+import com.google.protobuf.ListValue
+import com.google.protobuf.NullValue
+import com.google.protobuf.Struct
+import dev.openfeature.kotlin.sdk.EvaluationMetadata
+import dev.openfeature.kotlin.sdk.FeatureProvider
+import dev.openfeature.kotlin.sdk.FlagEvaluationDetails
+import dev.openfeature.kotlin.sdk.OpenFeatureAPI
+import dev.openfeature.kotlin.sdk.OpenFeatureStatus
+import dev.openfeature.kotlin.sdk.exceptions.OpenFeatureError
+import io.grpc.Status
+import io.grpc.StatusException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withTimeout
+import timber.log.Timber
+import com.google.protobuf.Value as ProtoValue
+import dev.openfeature.kotlin.sdk.EvaluationContext as OpenFeatureEvaluationContext
+import dev.openfeature.kotlin.sdk.Value as OfValue
+
+private const val TAG = "FeatureFlagService"
+private const val INIT_TIMEOUT_MS = 30_000L
+
+/**
+ * gRPC FeatureFlagService for online precomputed FLEX tests.
+ *
+ * [InitProvider] enables [Flags], builds a [FlagsClient] and registers it with
+ * [OpenFeatureAPI]; the evaluate / context RPCs go through the OpenFeature client.
+ */
+internal class FeatureFlagServiceImpl(
+    proxyUrl: String?,
+    private val initializationTimeoutMs: Long = INIT_TIMEOUT_MS,
+    private val createProvider: (InitProviderRequest) -> FeatureProvider = {
+        createAndroidProvider(it, proxyUrl)
+    }
+) :
+    FeatureFlagServiceGrpcKt.FeatureFlagServiceCoroutineImplBase() {
+
+    private var initialized = false
+
+    override suspend fun initProvider(request: InitProviderRequest): InitProviderResponse {
+        if (request.hasConfigurationWire()) {
+            throw unsupported("Only online precomputed initialization is implemented")
+        }
+        val context = toOfContext(request.context)
+        initialized = false
+        val provider = InitializationTrackingProvider(createProvider(request))
+
+        val andWait = !request.hasAndWait() || request.andWait
+        if (andWait) {
+            try {
+                withTimeout(initializationTimeoutMs) {
+                    OpenFeatureAPI.setProviderAndWait(provider, context)
+                }
+                requireReady("InitProvider")
+            } catch (failure: CancellationException) {
+                throw failure
+            } catch (failure: Exception) {
+                val parseError = provider.initializationParseError
+                if (parseError != null) {
+                    throw StatusException(
+                        Status.FAILED_PRECONDITION.withDescription(
+                            "FLEX_INIT_ERROR:INVALID_RESPONSE ${parseError.message ?: "Invalid feature flags response"}"
+                        )
+                    )
+                }
+                throw failure
+            }
+        } else {
+            OpenFeatureAPI.setProvider(provider, initialContext = context)
+        }
+        initialized = true
+        Timber.tag(TAG).i("InitProvider submitted andWait=%s", andWait)
+        return InitProviderResponse.getDefaultInstance()
+    }
+
+    override suspend fun setEvaluationContext(request: SetEvaluationContextRequest): SetEvaluationContextResponse {
+        requireClient()
+        val context = toOfContext(request.context)
+        val andWait = !request.hasAndWait() || request.andWait
+        if (andWait) {
+            withTimeout(initializationTimeoutMs) {
+                OpenFeatureAPI.setEvaluationContextAndWait(context)
+            }
+            requireReady("SetEvaluationContext")
+        } else {
+            OpenFeatureAPI.setEvaluationContext(context)
+        }
+        return SetEvaluationContextResponse.getDefaultInstance()
+    }
+
+    override suspend fun flushEmissions(request: FlushEmissionsRequest): FlushEmissionsResponse {
+        requireClient()
+        // Best effort: allow aggregation and automatic upload without shutting
+        // down SDK executors. The runner still polls intake for delivery.
+        delay(5_000L)
+        return FlushEmissionsResponse.getDefaultInstance()
+    }
+
+    override suspend fun evaluateBoolean(request: EvaluateBooleanRequest): EvaluateBooleanResponse {
+        requireClient()
+        val result = ofDetails(
+            OpenFeatureAPI.getClient().getBooleanDetails(request.flagKey, request.defaultValue)
+        )
+        return EvaluateBooleanResponse.newBuilder()
+            .setValue(result.value)
+            .apply { applyEvalFields(result) }
+            .build()
+    }
+
+    override suspend fun evaluateString(request: EvaluateStringRequest): EvaluateStringResponse {
+        requireClient()
+        val result = ofDetails(
+            OpenFeatureAPI.getClient().getStringDetails(request.flagKey, request.defaultValue)
+        )
+        return EvaluateStringResponse.newBuilder()
+            .setValue(result.value)
+            .apply { applyEvalFields(result) }
+            .build()
+    }
+
+    override suspend fun evaluateInteger(request: EvaluateIntegerRequest): EvaluateIntegerResponse {
+        requireClient()
+        val defaultValue = checkedIntegerDefault(request.defaultValue)
+        val result = ofDetails(
+            OpenFeatureAPI.getClient().getIntegerDetails(request.flagKey, defaultValue)
+        )
+        return EvaluateIntegerResponse.newBuilder()
+            .setValue(result.value.toLong())
+            .apply { applyEvalFields(result) }
+            .build()
+    }
+
+    override suspend fun evaluateFloat(request: EvaluateFloatRequest): EvaluateFloatResponse {
+        requireClient()
+        val result = ofDetails(
+            OpenFeatureAPI.getClient().getDoubleDetails(request.flagKey, request.defaultValue)
+        )
+        return EvaluateFloatResponse.newBuilder()
+            .setValue(result.value)
+            .apply { applyEvalFields(result) }
+            .build()
+    }
+
+    override suspend fun evaluateObject(request: EvaluateObjectRequest): EvaluateObjectResponse {
+        requireClient()
+        val result = ofDetails(
+            OpenFeatureAPI.getClient().getObjectDetails(
+                request.flagKey,
+                structToOfValue(request.defaultValue)
+            )
+        )
+        return EvaluateObjectResponse.newBuilder()
+            .setValue(ofValueToStruct(result.value))
+            .apply { applyEvalFields(result) }
+            .build()
+    }
+
+    private fun requireClient() {
+        if (!initialized) {
+            throw StatusException(
+                Status.FAILED_PRECONDITION.withDescription(
+                    "Provider not initialized — call InitProvider first"
+                )
+            )
+        }
+    }
+
+    private fun currentStateName(): String {
+        return when (OpenFeatureAPI.getStatus()) {
+            OpenFeatureStatus.Ready -> "READY"
+            is OpenFeatureStatus.Error, is OpenFeatureStatus.Fatal -> "ERROR"
+            OpenFeatureStatus.Stale, OpenFeatureStatus.Reconciling -> "STALE"
+            OpenFeatureStatus.NotReady -> "NOT_READY"
+        }
+    }
+
+    private fun requireReady(operation: String) {
+        val state = currentStateName()
+        if (state != "READY") {
+            throw StatusException(
+                Status.FAILED_PRECONDITION.withDescription(
+                    "$operation completed with provider state $state"
+                )
+            )
+        }
+    }
+}
+
+private class InitializationTrackingProvider(private val delegate: FeatureProvider) : FeatureProvider by delegate {
+    @Volatile
+    var initializationParseError: OpenFeatureError.ParseError? = null
+        private set
+
+    override suspend fun initialize(initialContext: OpenFeatureEvaluationContext?) {
+        try {
+            delegate.initialize(initialContext)
+        } catch (failure: OpenFeatureError.ParseError) {
+            initializationParseError = failure
+            throw failure
+        }
+    }
+}
+
+private fun unsupported(description: String): StatusException =
+    StatusException(Status.UNIMPLEMENTED.withDescription(description))
+
+private data class EvalFields<T>(
+    val value: T,
+    val variant: String?,
+    val reason: String?,
+    val errorCode: String?,
+    val metadata: Struct
+)
+
+private fun <T> ofDetails(details: FlagEvaluationDetails<T>): EvalFields<T> = EvalFields(
+    value = details.value,
+    variant = details.variant,
+    reason = details.reason,
+    errorCode = details.errorCode?.name,
+    metadata = exposedMetadata(details.metadata)
+)
+
+private fun EvaluateBooleanResponse.Builder.applyEvalFields(fields: EvalFields<*>): EvaluateBooleanResponse.Builder {
+    fields.variant?.let { setVariant(it) }
+    fields.reason?.let { setReason(it) }
+    fields.errorCode?.let { setErrorCode(it) }
+    if (fields.metadata.fieldsCount > 0) {
+        setFlagMetadata(fields.metadata)
+    }
+    return this
+}
+
+private fun EvaluateStringResponse.Builder.applyEvalFields(fields: EvalFields<*>): EvaluateStringResponse.Builder {
+    fields.variant?.let { setVariant(it) }
+    fields.reason?.let { setReason(it) }
+    fields.errorCode?.let { setErrorCode(it) }
+    if (fields.metadata.fieldsCount > 0) {
+        setFlagMetadata(fields.metadata)
+    }
+    return this
+}
+
+private fun EvaluateIntegerResponse.Builder.applyEvalFields(fields: EvalFields<*>): EvaluateIntegerResponse.Builder {
+    fields.variant?.let { setVariant(it) }
+    fields.reason?.let { setReason(it) }
+    fields.errorCode?.let { setErrorCode(it) }
+    if (fields.metadata.fieldsCount > 0) {
+        setFlagMetadata(fields.metadata)
+    }
+    return this
+}
+
+private fun EvaluateFloatResponse.Builder.applyEvalFields(fields: EvalFields<*>): EvaluateFloatResponse.Builder {
+    fields.variant?.let { setVariant(it) }
+    fields.reason?.let { setReason(it) }
+    fields.errorCode?.let { setErrorCode(it) }
+    if (fields.metadata.fieldsCount > 0) {
+        setFlagMetadata(fields.metadata)
+    }
+    return this
+}
+
+private fun EvaluateObjectResponse.Builder.applyEvalFields(fields: EvalFields<*>): EvaluateObjectResponse.Builder {
+    fields.variant?.let { setVariant(it) }
+    fields.reason?.let { setReason(it) }
+    fields.errorCode?.let { setErrorCode(it) }
+    if (fields.metadata.fieldsCount > 0) {
+        setFlagMetadata(fields.metadata)
+    }
+    return this
+}
+
+internal fun toOfContext(ctx: EvaluationContext): DatadogEvaluationContext {
+    val attributeKey = ctx.attributesMap["targetingKey"]
+        ?.takeIf { it.kindCase == ProtoValue.KindCase.STRING_VALUE }
+        ?.stringValue
+    val targetingKey = if (ctx.hasTargetingKey()) ctx.targetingKey else attributeKey
+    val attrs = ctx.attributesMap.filterKeys { it != "targetingKey" }
+        .mapValues { protoValueToOfValue(it.value) }
+    return DatadogEvaluationContext(targetingKeyOrNull = targetingKey, attributes = attrs)
+}
+
+internal fun protoValueToOfValue(value: ProtoValue): OfValue {
+    return when (value.kindCase) {
+        ProtoValue.KindCase.STRING_VALUE -> OfValue.String(value.stringValue)
+        ProtoValue.KindCase.BOOL_VALUE -> OfValue.Boolean(value.boolValue)
+        ProtoValue.KindCase.NUMBER_VALUE -> {
+            val n = value.numberValue
+            if (n == n.toInt().toDouble()) OfValue.Integer(n.toInt()) else OfValue.Double(n)
+        }
+        ProtoValue.KindCase.STRUCT_VALUE -> structToOfValue(value.structValue)
+        ProtoValue.KindCase.LIST_VALUE -> OfValue.List(
+            value.listValue.valuesList.map { protoValueToOfValue(it) }
+        )
+        else -> OfValue.Null
+    }
+}
+
+internal fun structToOfValue(struct: Struct): OfValue {
+    return OfValue.Structure(struct.fieldsMap.mapValues { protoValueToOfValue(it.value) })
+}
+
+internal fun ofValueToStruct(value: OfValue): Struct {
+    val structure = value.asStructure() ?: return Struct.getDefaultInstance()
+    return mapToStruct(structure.mapValues { ofValueToAny(it.value) })
+}
+
+private fun ofValueToAny(value: OfValue): Any? {
+    return when (value) {
+        is OfValue.String -> value.string
+        is OfValue.Boolean -> value.boolean
+        is OfValue.Integer -> value.integer
+        is OfValue.Double -> value.double
+        is OfValue.Structure -> value.structure.mapValues { ofValueToAny(it.value) }
+        is OfValue.List -> value.list.map { ofValueToAny(it) }
+        else -> null
+    }
+}
+
+private fun anyToProtoValue(value: Any?): ProtoValue {
+    return when (value) {
+        null -> ProtoValue.newBuilder().setNullValue(NullValue.NULL_VALUE).build()
+        is String -> ProtoValue.newBuilder().setStringValue(value).build()
+        is Boolean -> ProtoValue.newBuilder().setBoolValue(value).build()
+        is Int -> ProtoValue.newBuilder().setNumberValue(value.toDouble()).build()
+        is Long -> ProtoValue.newBuilder().setNumberValue(value.toDouble()).build()
+        is Float -> ProtoValue.newBuilder().setNumberValue(value.toDouble()).build()
+        is Double -> ProtoValue.newBuilder().setNumberValue(value).build()
+        is Map<*, *> -> ProtoValue.newBuilder().setStructValue(mapToStruct(value)).build()
+        is List<*> -> ProtoValue.newBuilder()
+            .setListValue(ListValue.newBuilder().addAllValues(value.map { anyToProtoValue(it) }))
+            .build()
+        else -> ProtoValue.newBuilder().setStringValue(value.toString()).build()
+    }
+}
+
+private fun mapToStruct(map: Map<*, *>): Struct {
+    val builder = Struct.newBuilder()
+    for ((key, value) in map) {
+        if (key is String) {
+            builder.putFields(key, anyToProtoValue(value))
+        }
+    }
+    return builder.build()
+}
+
+// OpenFeature Kotlin 0.6.2 exposes typed lookup but no metadata-key enumeration.
+// Read known keys emitted by the pinned provider without a second evaluation.
+internal fun exposedMetadata(metadata: EvaluationMetadata): Struct {
+    val values = mutableMapOf<String, Any>()
+    metadata.getString("allocationKey")?.let { values["allocationKey"] = it }
+    metadata.getString("__dd_split_serial_id")?.let { values["__dd_split_serial_id"] = it }
+    metadata.getInt("__dd_split_serial_id")?.let { values["__dd_split_serial_id"] = it }
+    metadata.getBoolean("doLog")?.let { values["doLog"] = it }
+    return mapToStruct(values)
+}
+
+private fun createAndroidProvider(request: InitProviderRequest, proxyUrl: String?): FeatureProvider {
+    val builder = FlagsConfiguration.Builder()
+        .useCustomFlagEndpoint(request.flaggingProxyUrl)
+    if (proxyUrl != null) {
+        builder
+            .useCustomExposureEndpoint("$proxyUrl/api/v2/exposures")
+            .useCustomEvaluationEndpoint("$proxyUrl/api/v2/flagevaluation")
+    }
+    if (request.hasEvaluationFlushIntervalMs()) {
+        builder.evaluationFlushInterval(request.evaluationFlushIntervalMs.toLong())
+    }
+    Flags.enable(builder.build())
+    return FlagsClient.Builder().build().asOpenFeatureProvider()
+}
+
+internal fun checkedIntegerDefault(value: Long): Int {
+    if (value < Int.MIN_VALUE.toLong() || value > Int.MAX_VALUE.toLong()) {
+        throw StatusException(Status.INVALID_ARGUMENT.withDescription("Integer default is outside native Int32 range"))
+    }
+    return value.toInt()
+}
