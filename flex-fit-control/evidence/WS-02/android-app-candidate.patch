+internal class FeatureFlagLifecycleTest {
+    @Before
+    fun resetProvider() = runBlocking { OpenFeatureAPI.clearProvider() }
+
+    @After
+    fun releaseProvider() = runBlocking { OpenFeatureAPI.clearProvider() }
+
+    @Test
+    fun `waiting initialization waits for the actual initial context`() = runBlocking {
+        val provider = ControlledProvider()
+        val service = FeatureFlagServiceImpl(null) { provider }
+        val operation = async { service.initProvider(initRequest()) }
+        withTimeout(2_000) { provider.started.await() }
+        assertFalse(operation.isCompleted)
+        assertEquals("subject", provider.context?.getTargetingKey())
+        provider.ready.complete(Unit)
+        withTimeout(2_000) { operation.await() }
+        assertEquals(true, service.evaluateBoolean(EvaluateBooleanRequest.getDefaultInstance()).value)
+    }
+
+    @Test
+    fun `nonwaiting initialization returns while download is pending`(): Unit = runBlocking {
+        val provider = ControlledProvider()
+        val service = FeatureFlagServiceImpl(null) { provider }
+        withTimeout(2_000) { service.initProvider(initRequest().toBuilder().setAndWait(false).build()) }
+        withTimeout(2_000) { provider.started.await() }
+        assertFalse(provider.ready.isCompleted)
+        assertEquals("subject", provider.context?.getTargetingKey())
+        provider.ready.complete(Unit)
+    }
+
+    @Test
+    fun `failed initialization cannot acknowledge readiness`() = runBlocking {
+        val provider = ControlledProvider(fail = true)
+        val service = FeatureFlagServiceImpl(null) { provider }
+        provider.ready.complete(Unit)
+        try {
+            withTimeout(2_000) { service.initProvider(initRequest()) }
+            throw AssertionError("Expected failed initialization")
+        } catch (_: io.grpc.StatusException) {
+            // The provider error is propagated as an IPC lifecycle failure.
+        }
+        try {
+            service.evaluateBoolean(EvaluateBooleanRequest.getDefaultInstance())
+            throw AssertionError("Expected initialization precondition")
+        } catch (failure: io.grpc.StatusException) {
+            assertEquals(io.grpc.Status.Code.FAILED_PRECONDITION, failure.status.code)
+        }
+    }
+
+    @Test
+    fun `integer RPC uses actual OpenFeature native integer path`() = runBlocking {
+        val provider = ControlledProvider()
+        provider.ready.complete(Unit)
+        val service = FeatureFlagServiceImpl(null) { provider }
+        service.initProvider(initRequest())
+        listOf(Int.MIN_VALUE.toLong(), 0L, Int.MAX_VALUE.toLong()).forEach { value ->
+            val response = service.evaluateInteger(
+                EvaluateIntegerRequest.newBuilder().setFlagKey("number").setDefaultValue(value).build()
+            )
+            assertEquals(value, response.value)
+        }
+        assertEquals(3, provider.integerCalls)
+        assertEquals(0, provider.doubleCalls)
+    }
+
+    @Test
+    fun `typed parse rejection carries the exact initialization prefix`() = runBlocking {
+        val provider = ControlledProvider(initializationFailure = OpenFeatureError.ParseError("invalid encoding"))
+        provider.ready.complete(Unit)
+        val service = FeatureFlagServiceImpl(null) { provider }
+        val failure = initializationFailure(service)
+        assertEquals("FLEX_INIT_ERROR:INVALID_RESPONSE invalid encoding", failure.status.description)
+        try {
+            service.evaluateBoolean(EvaluateBooleanRequest.getDefaultInstance())
+            throw AssertionError("Expected initialization precondition")
+        } catch (error: StatusException) {
+            assertEquals(io.grpc.Status.Code.FAILED_PRECONDITION, error.status.code)
+        }
+    }
+
+    @Test
+    fun `generic network and authentication errors cannot spoof invalid response`() = runBlocking {
+        listOf(
+            OpenFeatureError.GeneralError("network unavailable"),
+            OpenFeatureError.GeneralError("HTTP 401 unauthorized"),
+            OpenFeatureError.GeneralError("FLEX_INIT_ERROR:INVALID_RESPONSE invalid encoding"),
+            IllegalStateException("FLEX_INIT_ERROR:INVALID_RESPONSE invalid encoding")
+        ).forEach { error ->
+            OpenFeatureAPI.clearProvider()
+            val provider = ControlledProvider(initializationFailure = error)
+            provider.ready.complete(Unit)
+            val failure = initializationFailure(FeatureFlagServiceImpl(null) { provider })
+            assertFalse(failure.status.description.orEmpty().startsWith("FLEX_INIT_ERROR:INVALID_RESPONSE "))
+        }
+    }
+
+    @Test
+    fun `deadline takes precedence over a late typed parse error`() = runBlocking {
+        val provider = ControlledProvider(initializationFailure = OpenFeatureError.ParseError("late invalid encoding"))
+        val service = FeatureFlagServiceImpl(null, initializationTimeoutMs = 20) { provider }
+        try {
+            service.initProvider(initRequest())
+            throw AssertionError("Expected deadline")
+        } catch (error: TimeoutCancellationException) {
+            assertFalse(error.message.orEmpty().startsWith("FLEX_INIT_ERROR:INVALID_RESPONSE "))
+        } finally {
+            provider.ready.complete(Unit)
+        }
+    }
+
+    @Test
+    fun `nonwaiting parse failure preserves immediate acknowledgement and retry`() = runBlocking {
+        val invalid = ControlledProvider(initializationFailure = OpenFeatureError.ParseError("invalid encoding"))
+        invalid.ready.complete(Unit)
+        val ready = ControlledProvider()
+        ready.ready.complete(Unit)
+        var attempts = 0
+        val service = FeatureFlagServiceImpl(null) { if (attempts++ == 0) invalid else ready }
+        service.initProvider(initRequest().toBuilder().setAndWait(false).build())
+        withTimeout(2_000) { invalid.started.await() }
+        service.initProvider(initRequest())
+        assertTrue(service.evaluateBoolean(EvaluateBooleanRequest.getDefaultInstance()).value)
+    }
+
+    private suspend fun initializationFailure(service: FeatureFlagServiceImpl): StatusException {
+        return try {
+            withTimeout(2_000) { service.initProvider(initRequest()) }
+            throw AssertionError("Expected initialization rejection")
+        } catch (error: StatusException) {
+            error
+        }
+    }
+
+    private fun initRequest(): InitProviderRequest = InitProviderRequest.newBuilder()
+        .setContext(com.datadog.rumtestapp.ipc.EvaluationContext.newBuilder().setTargetingKey("subject"))
+        .build()
+}
+
+private class ControlledProvider(
+    private val fail: Boolean = false,
+    private val initializationFailure: Throwable? = null
+) : FeatureProvider {
+    val started = CompletableDeferred<Unit>()
+    val ready = CompletableDeferred<Unit>()
+    var context: EvaluationContext? = null
+    var integerCalls = 0
+    var doubleCalls = 0
+    override val metadata = object : ProviderMetadata {
+        override val name = "controlled-test-provider"
+    }
+    override val hooks: List<Hook<*>> = emptyList()
+
+    override suspend fun initialize(initialContext: EvaluationContext?) {
+        context = initialContext
+        started.complete(Unit)
+        ready.await()
+        initializationFailure?.let { throw it }
+        if (fail) {
+            throw OpenFeatureError.GeneralError("deliberate fetch failure")
+        }
+    }
+
+    override suspend fun onContextSet(oldContext: EvaluationContext?, newContext: EvaluationContext) {
+        context = newContext
+        delay(1)
+    }
+
+    override fun shutdown() = Unit
+    override fun observe(): Flow<OpenFeatureProviderEvents> = emptyFlow()
+    override fun track(
+        trackingEventName: String,
+        context: EvaluationContext?,
+        trackingEventDetails: TrackingEventDetails?
+    ) = Unit
+    override fun getBooleanEvaluation(key: String, defaultValue: Boolean, context: EvaluationContext?) =
+        ProviderEvaluation(true, variant = "on", reason = "STATIC")
+    override fun getStringEvaluation(key: String, defaultValue: String, context: EvaluationContext?) =
+        ProviderEvaluation(defaultValue)
+    override fun getIntegerEvaluation(
+        key: String,
+        defaultValue: Int,
+        context: EvaluationContext?
+    ): ProviderEvaluation<Int> {
+        integerCalls++
+        return ProviderEvaluation(defaultValue)
+    }
+    override fun getDoubleEvaluation(
+        key: String,
+        defaultValue: Double,
+        context: EvaluationContext?
+    ): ProviderEvaluation<Double> {
+        doubleCalls++
+        return ProviderEvaluation(defaultValue)
+    }
+    override fun getObjectEvaluation(key: String, defaultValue: Value, context: EvaluationContext?) =
+        ProviderEvaluation(defaultValue)
+}
