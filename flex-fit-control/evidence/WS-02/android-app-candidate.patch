new file mode 100644
index 0000000..abe17df
--- /dev/null
+++ b/apps/android/tools/prepare_online_sdk.rb
@@ -0,0 +1,59 @@
+#!/usr/bin/env ruby
+# Export the reviewed SDK layers to a private build graph; leave dependency caches unchanged.
+require 'digest'
+require 'fileutils'
+require 'json'
+require 'open3'
+require 'shellwords'
+
+usage = 'prepare_online_sdk.rb SDK_REPO NATIVE_PATCH NATIVE_SHA256 NUMERIC_PATCH NUMERIC_SHA256 OPENFEATURE_PATCH OPENFEATURE_SHA256 NEW_OUTPUT'
+abort "Usage: #{usage}" unless ARGV.size == 8
+sdk, native_patch, native_hash, numeric_patch, numeric_hash, of_patch, of_hash, output = ARGV
+base = 'dad2312223110e2e7ed84cf46cefe3a45bc759c6'
+output = File.expand_path(output)
+abort 'Output must not exist' if File.exist?(output)
+head, error, status = Open3.capture3('git', '-C', sdk, 'rev-parse', 'HEAD')
+abort error unless status.success?
+abort "SDK source must be at #{base}" unless head.strip == base
+layers = [['native_context', native_patch, native_hash], ['native_numeric', numeric_patch, numeric_hash], ['kotlin_openfeature', of_patch, of_hash]]
+receipt = { base: base, layers: [] }
+layers.each do |name, path, expected|
+  bytes = File.binread(path)
+  actual = Digest::SHA256.hexdigest(bytes)
+  abort "Patch checksum mismatch for #{name}: #{actual}" unless actual == expected
+  receipt[:layers] << { name: name, patch_sha256: actual }
+end
+stack_hash = Digest::SHA256.hexdigest(JSON.generate(receipt))
+version = "999.0.0-fit-ipc-#{stack_hash[0, 12]}"
+target = File.join(output, 'sdk')
+repository = File.join(output, 'maven')
+FileUtils.mkdir_p(target)
+Open3.popen3('git', '-C', sdk, 'archive', base) do |_, source, stderr, wait|
+  Open3.popen3('tar', '-x', '-C', target) do |sink, _, tar_error, tar_wait|
+    IO.copy_stream(source, sink)
+    sink.close
+    abort tar_error.read unless tar_wait.value.success?
+  end
+  abort stderr.read unless wait.value.success?
+end
+layers.each do |name, path, _|
+  bytes = File.binread(path)
+  patch_copy = File.join(output, "#{name}.patch")
+  File.binwrite(patch_copy, bytes)
+  _, error, status = Open3.capture3('git', 'apply', '--unsafe-paths', "--directory=#{target}", patch_copy)
+  abort "Cannot apply #{name}: #{error}" unless status.success?
+end
+fit = File.expand_path('../../..', __dir__)
+init = File.join(fit, 'src/rum_sdk_test/drivers/resources/force-local-version.init.gradle.kts')
+flags = %w[--no-watch-fs --no-configuration-cache --no-daemon --console=plain]
+publish = ['./gradlew', 'publishToMavenLocal', '-I', init, "-PforcedLocalVersion=#{version}", "-Dmaven.repo.local=#{repository}", '-Pdd-skip-signing=true'] + flags
+build = ['./gradlew', ':app:testDebugUnitTest', ':app:assembleDebug', "-PdatadogSdkLocalVersion=#{version}", "-PdatadogSdkLocalRepository=#{repository}"] + flags
+[['publish.sh', target, publish], ['build-app.sh', File.join(fit, 'apps/android'), build]].each do |name, directory, command|
+  path = File.join(output, name)
+  File.write(path, "#!/usr/bin/env bash\nset -euo pipefail\ncd #{Shellwords.escape(directory)}\nexec #{Shellwords.join(command)}\n")
+  FileUtils.chmod(0o755, path)
+end
+receipt.merge!(stack_sha256: stack_hash, version: version, repository: repository)
+File.write(File.join(output, 'source-stack.json'), JSON.pretty_generate(receipt) + "\n")
+puts JSON.pretty_generate(receipt)
+puts "Run #{File.join(output, 'publish.sh')}, then #{File.join(output, 'build-app.sh')} with JAVA_HOME and ANDROID_HOME set."
