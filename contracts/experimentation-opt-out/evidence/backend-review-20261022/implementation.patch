+func TestSplitsRandomize(t *testing.T) {
+	half := mkShard1("s", 0, 2, 4)
+	otherHalf := mkShard1("s", 2, 4, 4)
+	for _, tc := range []struct {
+		name   string
+		splits []coreSplit
+		want   bool
+	}{
+		{"no assignment", nil, false},
+		{"deterministic winner", []coreSplit{{VariationKey: "a"}}, false},
+		{"percentage enrollment", []coreSplit{{VariationKey: "a", Shards: []coreShard{half}}}, true},
+		{"two variants", []coreSplit{{VariationKey: "a", Shards: []coreShard{half}}, {VariationKey: "b", Shards: []coreShard{otherHalf}}}, true},
+		{"same variant covers all buckets", []coreSplit{{VariationKey: "a", Shards: []coreShard{half}}, {VariationKey: "a", Shards: []coreShard{otherHalf}}}, false},
+		{"unreachable different variant", []coreSplit{{VariationKey: "a"}, {VariationKey: "b", Shards: []coreShard{half}}}, false},
+		{"empty variant range", []coreSplit{{VariationKey: "b", Shards: []coreShard{mkShard1("s", 0, 0, 4)}}, {VariationKey: "a"}}, false},
+		{"contradictory same-dimension shards", []coreSplit{{VariationKey: "b", Shards: []coreShard{half, otherHalf}}, {VariationKey: "a"}}, false},
+		{"independent enrollment and variation", []coreSplit{{VariationKey: "a", Shards: []coreShard{half, mkShard1("t", 0, 2, 4)}}, {VariationKey: "b", Shards: []coreShard{otherHalf}}}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, tc.want, splitsRandomize(tc.splits))
+		})
+	}
+}
+
+// Enumerate raw buckets independently of the region normalization and interval
+// recursion used by the compiler, including overlaps and first-match shadowing.
+func TestSplitsRandomizeMatchesBucketEnumeration(t *testing.T) {
+	rng := rand.New(rand.NewSource(0xD0106))
+	for iteration := 0; iteration < 500; iteration++ {
+		var splits []coreSplit
+		for i, n := 0, rng.Intn(6); i < n; i++ {
+			split := coreSplit{VariationKey: fmt.Sprintf("v%d", rng.Intn(2))}
+			for j, n := 0, rng.Intn(5); j < n; j++ {
+				start := int64(rng.Intn(5))
+				end := start + int64(rng.Intn(5-int(start)))
+				split.Shards = append(split.Shards, mkShard1([]string{"x", "y"}[rng.Intn(2)], start, end, 4))
+			}
+			splits = append(splits, split)
+		}
+		outcomes := map[string]bool{}
+		for x := int64(0); x < 4; x++ {
+			for y := int64(0); y < 4; y++ {
+				outcome := "fallthrough"
+				for _, split := range splits {
+					matches := true
+					for _, shard := range split.Shards {
+						bucket := x
+						if shard.Salt == "y" {
+							bucket = y
+						}
+						inRange := false
+						for _, r := range shard.Ranges {
+							inRange = inRange || (r.Start <= bucket && bucket < r.End)
+						}
+						matches = matches && inRange
+					}
+					if matches {
+						outcome = split.VariationKey
+						break
+					}
+				}
+				outcomes[outcome] = true
+			}
+		}
+		assert.Equal(t, len(outcomes) > 1, splitsRandomize(splits), "iteration %d: %+v", iteration, splits)
+	}
+}
