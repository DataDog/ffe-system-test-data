+// splitsRandomize reports whether changing a subject's buckets can change the
+// selected variation or whether the allocation matches. Targeting rules and
+// time windows are deterministic gates, so they are not part of this check.
+// Preserve first-match order: a later split hidden by an earlier one does not
+// introduce randomization, nor do multiple splits that always serve one variant.
+func splitsRandomize(splits []coreSplit) bool {
+	regions, dimensions := splitsToRegions(splits)
+	variations := make([]string, len(splits))
+	for i, split := range splits {
+		variations[i] = split.VariationKey
+	}
+	_, constant := constantPartitionAssignment(regions, variations, dimensions)
+	return !constant
+}
+
+type partitionAssignment struct {
+	matched      bool
+	variationKey string
+}
+
+func constantPartitionAssignment(regions []partitionRegion, variations []string, dimensions []partitionDimension) (partitionAssignment, bool) {
+	if len(dimensions) == 0 {
+		if len(regions) == 0 {
+			return partitionAssignment{}, true
+		}
+		return partitionAssignment{matched: true, variationKey: variations[0]}, true
+	}
+	dimension, rest := dimensions[0], dimensions[1:]
+	breakpoints := elementaryIntervals(regions, dimension)
+	var first partitionAssignment
+	for i := 0; i < len(breakpoints)-1; i++ {
+		lo, hi := breakpoints[i], breakpoints[i+1]
+		var sub []partitionRegion
+		var subVariations []string
+		for j, region := range regions {
+			rs, constrained := region[dimension]
+			if !constrained || containsInterval(rs, lo, hi) {
+				sub = append(sub, projectOut(region, dimension))
+				subVariations = append(subVariations, variations[j])
+			}
+		}
+		assignment, constant := constantPartitionAssignment(sub, subVariations, rest)
+		if !constant || (i > 0 && assignment != first) {
+			return partitionAssignment{}, false
+		}
+		first = assignment
+	}
+	return first, true
+}
+
 // splitsToRegions converts raw Splits into partitionRegions suitable for
 // the recursive coverage check, and reports the universe of partition
 // dimensions they reference.
