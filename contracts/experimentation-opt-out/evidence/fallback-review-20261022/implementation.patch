 )
 
+//go:embed testdata/semver_delivery.json
+var semverDeliveryCases []byte
+
+// Authored targeting determines compatibility even when its rule is unreachable.
+// Overrides bypass the authored waterfall, including its SemVer requirement.
+func TestFilterSemverFlagsUsesAuthoredTargeting(t *testing.T) {
+	var cases []struct {
+		ID   string `json:"id"`
+		Args struct {
+			FirstAllocation string `json:"firstAllocation"`
+			AuthoredSemver  bool   `json:"authoredSemver"`
+			Override        bool   `json:"override"`
+			RolloutEnabled  bool   `json:"rolloutEnabled"`
+		} `json:"args"`
+		Expected struct {
+			PrimaryContains       bool `json:"primaryContains"`
+			CompatibilityContains bool `json:"compatibilityContains"`
+			SemverRetained        bool `json:"semverRetained"`
+		} `json:"expected"`
+	}
+	require.NoError(t, json.Unmarshal(semverDeliveryCases, &cases))
+	require.Len(t, cases, 24)
+	for _, tc := range cases {
+		t.Run(tc.ID, func(t *testing.T) {
+			ff := baseFeatureFlag()
+			first := model.Allocation{Key: "first", Type: model.AllocationTypeFeatureGate, OrderPosition: 0,
+				VariantWeights: []model.VariantWeight{{Value: 1, Variant: &ff.Variants[0]}}}
+			switch tc.Args.FirstAllocation {
+			case "ordinary":
+			case "completed", "active":
+				first.ExperimentID = common.Ptr("experiment-id")
+				first.ExperimentRolloutComplete = tc.Args.FirstAllocation == "completed"
+			default:
+				t.Fatalf("unknown first allocation: %s", tc.Args.FirstAllocation)
+			}
+			fallback := model.Allocation{Key: "fallback", OrderPosition: 1,
+				VariantWeights: []model.VariantWeight{{Value: 1, Variant: &ff.Variants[1]}}}
+			if tc.Args.AuthoredSemver {
+				fallback.TargetingRules = []model.TargetingRule{{Conditions: []model.Condition{{
+					Operator:  common.Ptr(model.ConditionOperatorSemverGTE),
+					Attribute: common.Ptr("app_version"), Value: []string{"2.0.0"},
+				}}}}
+			}
+			ff.CurrentEnvironment.Allocations = []model.Allocation{first, fallback}
+			if tc.Args.Override {
+				ff.CurrentEnvironment.OverrideVariant = &ff.Variants[1]
+			}
+			ordinary := baseFeatureFlag()
+			ordinary.Key = "unrelated"
+			ctx := context.Background()
+			if tc.Args.RolloutEnabled {
+				ctx = common.WithServerSDKSemverEnabled(ctx)
+			}
+			env := &model.Environment{ID: "env-id", Name: "staging"}
+			channel := model.DistributionChannelServer
+			now := time.Date(2026, 10, 20, 12, 0, 0, 0, time.UTC)
+			config := BuildFlagsConfiguration(ctx, env, []*model.FeatureFlag{ff, ordinary}, &channel, now, nil, nil)
+			before, err := json.Marshal(config.ToJSON())
+			require.NoError(t, err)
+			compatibility, keys := FilterSemverFlags(&config)
+			_, primaryContains := config.core.Flags[ff.Key]
+			_, compatibilityContains := compatibility.core.Flags[ff.Key]
+			assert.Equal(t, tc.Expected.PrimaryContains, primaryContains)
+			assert.Equal(t, tc.Expected.CompatibilityContains, compatibilityContains)
+			assert.Contains(t, compatibility.core.Flags, ordinary.Key)
+			if primaryContains && !tc.Expected.CompatibilityContains {
+				assert.Equal(t, []string{ff.Key}, keys)
+			} else {
+				assert.Empty(t, keys)
+			}
+			retained := false
+			if flag := config.core.Flags[ff.Key]; flag != nil {
+				for _, allocation := range flag.Allocations {
+					for _, rule := range allocation.Rules {
+						for _, condition := range rule.Conditions {
+							retained = retained || strings.HasPrefix(string(condition.Operator), "SEMVER_")
+						}
+					}
+				}
+				assignment, err := GetAssignment(winnerFixtureEvaluator(t, config), ff.Key, "eligible", nil, nil, now)
+				require.NoError(t, err)
+				require.NotNil(t, assignment)
+				wantVariant := ff.Variants[0].Key
+				if tc.Args.Override {
+					wantVariant = ff.Variants[1].Key
+				}
+				assert.Equal(t, wantVariant, assignment.VariationKey)
+			}
+			assert.Equal(t, tc.Expected.SemverRetained, retained)
+			after, err := json.Marshal(config.ToJSON())
+			require.NoError(t, err)
+			assert.Equal(t, before, after, "filtering must not mutate the capable-client payload")
+			_, jsonContains := compatibility.ToJSON().Flags[ff.Key]
+			assert.Equal(t, tc.Expected.CompatibilityContains, jsonContains)
+			protobuf, err := compatibility.ToProto()
+			require.NoError(t, err)
+			_, protoContains := protobuf.Flags[ff.Key]
+			assert.Equal(t, tc.Expected.CompatibilityContains, protoContains)
+		})
+	}
+}
