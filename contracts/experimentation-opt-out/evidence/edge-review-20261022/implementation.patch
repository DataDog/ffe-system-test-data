+#[test]
+fn acknowledgement_normalizes_cutoff_without_losing_precision() {
+    for (cutoff, expected) in [
+        ("2026-10-01T08:00:00-04:00", "2026-10-01T12:00:00Z"),
+        ("2026-10-01T12:00:00.5Z", "2026-10-01T12:00:00.500Z"),
+        ("2026-10-01T12:00:00.1234Z", "2026-10-01T12:00:00.123400Z"),
+        ("2026-10-01T12:00:00.000Z", "2026-10-01T12:00:00Z"),
+        ("2026-10-01T12:00:00.5+01:00", "2026-10-01T11:00:00.500Z"),
+        (
+            "2026-10-01T12:00:00.123456789Z",
+            "2026-10-01T12:00:00.123456789Z",
+        ),
+    ] {
+        for rkyv in [false, true] {
+            for streaming in [false, true] {
+                let config = configuration(json!("2026-01-01T00:00:00Z"));
+                let backend = if rkyv {
+                    mock_cached_rkyv_response(&config, &[])
+                } else {
+                    mock_cached_json_response(&config, &[])
+                };
+                let req = Request::post("https://test-host/precompute-assignments")
+                    .with_header("dd-client-token", "test-token")
+                    .with_body_json(&body(
+                        json!({"experimentation_opt_out_mode": "future_experiments_only"}),
+                        Some(json!(cutoff)),
+                    ))
+                    .unwrap();
+                let mut handler = make_handler(
+                    req,
+                    &backend,
+                    Ok(if rkyv {
+                        BasisPoints::FULL
+                    } else {
+                        BasisPoints::ZERO
+                    }),
+                );
+                handler.stream_rollout = Ok(if streaming {
+                    BasisPoints::FULL
+                } else {
+                    BasisPoints::ZERO
+                });
+                let prepared = handler.prepare().unwrap();
+                let bytes = if streaming {
+                    let mut writer = Vec::new();
+                    handler.write_stream(prepared, &mut writer, |_| Ok(()));
+                    assert!(handler.metrics.io_error.is_none());
+                    writer
+                } else {
+                    let mut response = handler.respond_for_test(Ok(prepared));
+                    assert_eq!(response.get_status(), StatusCode::OK);
+                    response.take_body_bytes()
+                };
+                let response: Value = serde_json::from_slice(&bytes).unwrap();
+                assert_eq!(
+                    response["data"]["attributes"]["evaluation_options"],
+                    json!({
+                        "experimentation_opt_out_mode": "future_experiments_only",
+                        "dd_experimentation_opt_out_at": expected,
+                    }),
+                    "{cutoff}, rkyv={rkyv}, streaming={streaming}"
+                );
+            }
+        }
+    }
+}
